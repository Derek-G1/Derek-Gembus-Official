# ---------------------------------------------------------------------
# Derek Gembus - Apache configuration (cPanel / public_html)
# Deployed by .cpanel.yml as part of build/
# ---------------------------------------------------------------------

# ----------------------------------------------------------------------
# 1. Force HTTPS + canonical host (fixes the browser "Not Secure" warning)
#    Everything is sent to https://derekgembus.com in a SINGLE redirect so
#    that http://www. never has to complete a TLS handshake on the www
#    hostname first.
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Plain HTTP -> HTTPS (covers both direct requests and proxy/CDN fronting)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://derekgembus.com%{REQUEST_URI} [R=301,L,NE]

  # www -> non-www (canonical host matches index.html, sitemap.xml, robots.txt)
  RewriteCond %{HTTP_HOST} ^www\.derekgembus\.com$ [NC]
  RewriteRule ^ https://derekgembus.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# ----------------------------------------------------------------------
# 2. Security headers
#    HSTS is intentionally set WITHOUT includeSubDomains/preload so that
#    cPanel service subdomains (mail., cpanel., webmail.) are unaffected.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------------------
# 3. Deny access to dotfiles and VCS metadata
#    (<DirectoryMatch> is server-config only and is NOT valid inside an
#    .htaccess file, so the rule is expressed with mod_rewrite instead.)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# ----------------------------------------------------------------------
# 4. React Router (SPA) fallback - must stay last
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
